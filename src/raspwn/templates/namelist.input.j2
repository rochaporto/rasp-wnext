{#- Rendered by raspwn.pipeline. Physics loosely follows common RASP setups:
    YSU PBL (its PBLH is what BLIPMAP fields are built on), Noah LSM,
    Thompson microphysics, RRTMG radiation with slope/shading effects. -#}
{%- macro each(v) %}{% for d in domains %}{{ v }},{% endfor %}{% endmacro -%}
&time_control
 start_year         = {{ each(start_dt.year) }}
 start_month        = {{ each('%02d' % start_dt.month) }}
 start_day          = {{ each('%02d' % start_dt.day) }}
 start_hour         = {{ each('%02d' % start_dt.hour) }}
 end_year           = {{ each(end_dt.year) }}
 end_month          = {{ each('%02d' % end_dt.month) }}
 end_day            = {{ each('%02d' % end_dt.day) }}
 end_hour           = {{ each('%02d' % end_dt.hour) }}
 interval_seconds   = {{ interval }}
 input_from_file    = {{ each('.true.') }}
 history_interval   = {{ each(60) }}
 frames_per_outfile = {{ each(1) }}
 restart            = .false.,
 io_form_history    = 2,
 io_form_restart    = 2,
 io_form_input      = 2,
 io_form_boundary   = 2,
 adjust_output_times = .true.,
/

&domains
 time_step              = {{ time_step }},
 max_dom                = {{ domains|length }},
 e_we                   = {% for d in domains %}{{ d.e_we }},{% endfor %}
 e_sn                   = {% for d in domains %}{{ d.e_sn }},{% endfor %}
 e_vert                 = {{ each(e_vert) }}
 auto_levels_opt        = 2,
 dzbot                  = 30.,
 dzstretch_s            = 1.1,
 dzstretch_u            = 1.1,
 max_dz                 = 1000.,
 p_top_requested        = 5000,
 num_metgrid_levels     = {{ num_metgrid_levels }},
 num_metgrid_soil_levels = 4,
 dx                     = {% for d in domains %}{{ d.dx }},{% endfor %}
 dy                     = {% for d in domains %}{{ d.dx }},{% endfor %}
 grid_id                = {% for d in domains %}{{ loop.index }},{% endfor %}
 parent_id              = {% for d in domains %}{{ d.parent_id }},{% endfor %}
 i_parent_start         = {% for d in domains %}{{ d.i_start }},{% endfor %}
 j_parent_start         = {% for d in domains %}{{ d.j_start }},{% endfor %}
 parent_grid_ratio      = {% for d in domains %}{{ d.ratio }},{% endfor %}
 parent_time_step_ratio = {% for d in domains %}{{ d.ratio }},{% endfor %}
 feedback               = 1,
 smooth_option          = 0,
/

&physics
 mp_physics         = {{ each(physics.mp_physics) }}
 ra_lw_physics      = {{ each(physics.ra_lw_physics) }}
 ra_sw_physics      = {{ each(physics.ra_sw_physics) }}
 radt               = {{ each(physics.radt) }}
 slope_rad          = {{ each(1) }}
 topo_shading       = {{ each(1) }}
 sf_sfclay_physics  = {{ each(physics.sf_sfclay_physics) }}
 sf_surface_physics = {{ each(physics.sf_surface_physics) }}
 bl_pbl_physics     = {{ each(physics.bl_pbl_physics) }}
 bldt               = {{ each(0) }}
 cu_physics         = {% for d in domains %}{{ physics.cu_physics if d.dx > 5000 else 0 }},{% endfor %}
 cudt               = {{ each(0) }}
 isfflx             = 1,
 icloud             = 1,
 surface_input_source = 3,
 num_soil_layers    = 4,
 num_land_cat       = 21,
 sf_urban_physics   = {{ each(0) }}
/

&dynamics
 hybrid_opt   = 2,
 w_damping    = 1,
 diff_opt     = {{ each(2) }}
 km_opt       = {{ each(4) }}
 diff_6th_opt = {{ each(0) }}
 base_temp    = 290.,
 damp_opt     = 3,
 zdamp        = {{ each('5000.') }}
 dampcoef     = {{ each(0.2) }}
 khdif        = {{ each(0) }}
 kvdif        = {{ each(0) }}
 non_hydrostatic = {{ each('.true.') }}
 moist_adv_opt   = {{ each(1) }}
 scalar_adv_opt  = {{ each(1) }}
 epssm           = {{ each(0.2) }}
/

&bdy_control
 spec_bdy_width = 5,
 specified      = .true.,
/

&namelist_quilt
 nio_tasks_per_group = 0,
 nio_groups = 1,
/
